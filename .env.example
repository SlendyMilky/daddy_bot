# ── Bot core ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace_me
OPENAI_API_KEY=
OPENAI_START_MODEL=gpt-4.1-mini
RAPIDAPI_KEY=
GOOGLE_MAPS_API_KEY=

# ── Rate limit ────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_EVENTS=8
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_COOLDOWN_MESSAGE=Doucement champion, respire 2 secondes et recommence.

# ── Ownership ─────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs granted owner-level access (bot admin commands + web panel).
OWNER_IDS=

# ── Bibine ────────────────────────────────────────────────────────────────────
BIBINE_CHANNEL_ID=
BIBINE_TIMEZONE=Europe/Paris

# ── Princesse matin ───────────────────────────────────────────────────────────
PRINCESSE_MORNING_ENABLED=true
PRINCESSE_MORNING_TIMEZONE=Europe/Paris
PRINCESSE_MORNING_START_HOUR=6
PRINCESSE_MORNING_END_HOUR=10
# Comma-separated group chat IDs that receive the morning ritual.
PRINCESSE_MORNING_CHAT_IDS=-1001153426467,-1001805681499

# ── Admin web panel ───────────────────────────────────────────────────────────
ADMIN_WEB_ENABLED=true
ADMIN_WEB_PORT=8080
# Public HTTPS URL used as the OIDC redirect_uri base (no trailing slash).
ADMIN_WEB_PUBLIC_URL=https://yourdomain.example.com
# Random secret for signing session cookies and CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_WEB_SECRET_KEY=replace_me_with_random_hex_64_chars
# Session lifetime in hours (default: 7 days).
ADMIN_SESSION_TTL_HOURS=168

# ── Telegram OIDC (Sign in with Telegram) ─────────────────────────────────────
# Register your bot as an OAuth app via @BotFather or the Telegram developer portal.
# Set the redirect URI to: ${ADMIN_WEB_PUBLIC_URL}/admin/auth/callback
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Discovery document URL — override only if Telegram changes the endpoint.
TELEGRAM_OIDC_DISCOVERY_URL=https://oauth.telegram.org/.well-known/openid-configuration
